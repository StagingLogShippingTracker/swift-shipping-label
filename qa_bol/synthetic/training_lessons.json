  "lessons": [
    {
      "id": "20260821T065009Z",
      "ts": "2026-08-21T06:50:09Z",
      "title": "Long tracking fields must stay visible",
      "lesson": "Sales Order / PO / Project / Packing List must shrink or wrap \u2014 never clip away. Logos never invade Probill or Swift ink. logo_wide overcrowding is next curriculum target when gates are green.",
      "do_not_regress": "tracking field visibility + logo/Probill/Swift clearance",
      "case_ids": [
        "text_long_all_refs",
        "logo_wide"
      ],
      "tags": [
        "layout"
      ]
    },
    {
      "id": "20260821T065027Z",
      "ts": "2026-08-21T06:50:27Z",
      "title": "ORDER # must resolve sales_order",
      "lesson": "bolSample sets LabelFields.salesOrder but tracking row read BolFields.orderNum only \u2014 ORDER appeared empty on north-star. Prefer order_num then sales_order (and packing_list then packing_slip).",
      "do_not_regress": "ORDER # empty when sales_order set",
      "case_ids": [
        "baseline_sample"
      ],
      "tags": [
        "tracking",
        "order_num"
      ]
    },
    {
      "id": "20260821T065027Z",
      "ts": "2026-08-21T06:50:27Z",
      "title": "Long tracking refs: shrink + wrap (2 lines)",
      "lesson": "Single-line _drawValue overflowed/cut long unbroken PO/project/packing strings. Use shrinkToFit + char-break wrap with maxLines=2 and slightly taller value row so text stays visible.",
      "do_not_regress": "Long SO/PO/project/packing list clipped or vanished",
      "case_ids": [
        "text_long_all_refs",
        "text_long_po"
      ],
      "tags": [
        "tracking",
        "shrink",
        "wrap"
      ]
    },
    {
      "id": "20260821T065028Z",
      "ts": "2026-08-21T06:50:28Z",
      "title": "Fit full logo bitmap inside header cell",
      "lesson": "logo_wide overcrowding=0.4: ink-fitted height ignored transparent canvas pad so draw rect exceeded customer_logo_frame (clip hid bleed). Scale so drawHeight/drawWidth fit cell before draw; keep Probill/Swift locked.",
      "do_not_regress": "Customer logo draw box outside left header frame",
      "case_ids": [
        "logo_wide"
      ],
      "tags": [
        "logo",
        "overcrowding",
        "wide"
      ]
    },
    {
      "id": "20260822T175632Z",
      "ts": "2026-08-22T17:56:32Z",
      "title": "Dual logos: stack before shrink; center in frame",
      "lesson": "Side-by-side half-width cells left-pin and over-shrink wide dual marks. Prefer vertical stack (full frame width, no half cells) when min stacked height beats side-by-side; allow band up to dualStackMaxBandH; always center ink in the customer frame between margin and Probill. Fall back to centered side-by-side when stack is not larger.",
      "do_not_regress": "Probill/Swift absolute lock; customerToProbillGap 12; never invent per-customer logo layout",
      "case_ids": [],
      "tags": []
    },
    {
      "id": "20260822T175805Z",
      "ts": "2026-08-22T17:58:05Z",
      "title": "Dual logos: stack-before-shrink + center in Probill frame",
      "lesson": "Side-by-side half-width cells left-pinned and over-shrunk dual marks. Prefer vertical stack (full frame width, optional band up to dualStackMaxBandH) when min stacked height beats side-by-side; always center ink in the customer frame between margin and Probill. Fall back to side-by-side only when stack is not larger.",
      "do_not_regress": "never invade Probill/Swift; Shipping SO/Contact lock untouched",
      "case_ids": [],
      "tags": []
    },
    {
      "id": "20260822T232200Z",
      "ts": "2026-08-22T23:22:00Z",
      "title": "BOL logos: fixed frame only (v1.1.89)",
      "lesson": "Customer logos live in a clipped frame left of Probill (frameRightLimit = staticLeft - customerToProbillGap). Header band height stays math.max(swiftH, customerLogoTargetH) — never grow usedBandH / dualStackMaxBandH. Single: _maxInkHeightInBox fills frameW×frameH. Dual: equal side-by-side cells, sharedHeightForCells capped by frameH. Do not stack or grow the band (v1.1.87 experiment reverted).",
      "do_not_regress": "title bar y advance; Probill/Swift lock; no stack/center band growth",
      "case_ids": [
        "logo_dual_arc_trialta",
        "logo_mixed_square_rect",
        "logo_ultra_wide_murrays"
      ],
